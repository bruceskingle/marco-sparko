        // The last build, without building it again.
        {
            "name": "Debug Pre-built app",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/target/debug/marco-sparko",
            "cwd": "${workspaceFolder}",
            "env": {
                "CARGO_MANIFEST_DIR": "${workspaceFolder}",
                "RUST_BACKTRACE": "1",
                "OS_ACTIVITY_MODE": "disable"
            }
        },

        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug Dioxus Desktop App",
            "cargo": {
                "args": [
                    "build",
                    "--bin=marco-sparko",
                    "--package=marco-sparko",
                    "--features=dioxus/desktop"
                ],
                "filter": {
                    "name": "marco-sparko",
                    "kind": "bin"
                }
            },
            "args": [
                "-v"
            ],
            "cwd": "${workspaceFolder}",
            "stdio": [null, "${workspaceFolder}/target/verbose.log", null],
            "env": {
                "CARGO_MANIFEST_DIR": "${workspaceFolder}",
                "RUST_BACKTRACE": "1",
                "OS_ACTIVITY_MODE": "disable"
            }
        },
        // The app with the demo profile, a redacted, offline, copy of a real profile's data, e.g. for screenshots, see
        // docs/Redaction.md. Make or refresh it with: marco-sparko --redact <profile> demo
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug Dioxus Desktop App (demo)",
            "cargo": {
                "args": [
                    "build",
                    "--bin=marco-sparko",
                    "--package=marco-sparko",
                    "--features=dioxus/desktop"
                ],
                "filter": {
                    "name": "marco-sparko",
                    "kind": "bin"
                }
            },
            "args": [
                "-v",
                "--profile",
                "demo"
            ],
            "cwd": "${workspaceFolder}",
            "stdio": [null, "${workspaceFolder}/target/verbose.log", null],
            "env": {
                "CARGO_MANIFEST_DIR": "${workspaceFolder}",
                "RUST_BACKTRACE": "1",
                "OS_ACTIVITY_MODE": "disable"
            }
        },
        // Fetches the latest data without a window, as a scheduled fetch does, see docs/ScheduledFetch.md. It uses the
        // profile the app last used, add "--profile", "<name>" to the args for another one. Its output is in the
        // terminal.
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug Fetch Latest Data",
            "cargo": {
                "args": [
                    "build",
                    "--bin=marco-sparko",
                    "--package=marco-sparko",
                    "--features=dioxus/desktop"
                ],
                "filter": {
                    "name": "marco-sparko",
                    "kind": "bin"
                }
            },
            "args": [
                "--fetch"
            ],
            "cwd": "${workspaceFolder}",
            "terminal": "integrated",
            "env": {
                "CARGO_MANIFEST_DIR": "${workspaceFolder}",
                "RUST_BACKTRACE": "1",
                "OS_ACTIVITY_MODE": "disable"
            }
        },
        // Copies a profile's data to the demo profile with everything which identifies you replaced, without a window,
        // see docs/Redaction.md. It asks which profile to copy. Its output is in the terminal.
        {
            "type": "lldb",
            "request": "launch",
            "name": "Redact Profile into Demo",
            "cargo": {
                "args": [
                    "build",
                    "--bin=marco-sparko",
                    "--package=marco-sparko",
                    "--features=dioxus/desktop"
                ],
                "filter": {
                    "name": "marco-sparko",
                    "kind": "bin"
                }
            },
            "args": [
                "--redact",
                "${input:redactProfile}",
                "demo"
            ],
            "cwd": "${workspaceFolder}",
            "terminal": "integrated",
            "env": {
                "CARGO_MANIFEST_DIR": "${workspaceFolder}",
                "RUST_BACKTRACE": "1",
                "OS_ACTIVITY_MODE": "disable"
            }
        },
        // Takes the screenshots in docs/screenshots.json, then exits, see docs/Screenshots.md: in the data directory
        // /Users/yourname, which it clears first, for the first run, then with a copy of the demo profile. The first
        // time, macOS asks for the Screen Recording permission for VS Code.
        {
            "type": "lldb",
            "request": "launch",
            "name": "Take Screenshots",
            "cargo": {
                "args": [
                    "build",
                    "--bin=marco-sparko",
                    "--package=marco-sparko",
                    "--features=dioxus/desktop"
                ],
                "filter": {
                    "name": "marco-sparko",
                    "kind": "bin"
                }
            },
            "args": [
                "--home",
                "/Users/yourname",
                "--screenshots"
            ],
            "cwd": "${workspaceFolder}",
            "terminal": "integrated",
            "env": {
                "CARGO_MANIFEST_DIR": "${workspaceFolder}",
                "RUST_BACKTRACE": "1",
                "OS_ACTIVITY_MODE": "disable"
            }
        },
        // Redacts the documents in unredacted_docs into docs, replacing those there, see docs/Redaction.md. Its output
        // is in the terminal.
        {
            "type": "lldb",
            "request": "launch",
            "name": "Redact Docs",
            "cargo": {
                "args": [
                    "build",
                    "--bin=marco-sparko",
                    "--package=marco-sparko",
                    "--features=dioxus/desktop"
                ],
                "filter": {
                    "name": "marco-sparko",
                    "kind": "bin"
                }
            },
            "args": [
                "--redact",
                "docs"
            ],
            "cwd": "${workspaceFolder}",
            "terminal": "integrated",
            "env": {
                "CARGO_MANIFEST_DIR": "${workspaceFolder}",
                "RUST_BACKTRACE": "1",
                "OS_ACTIVITY_MODE": "disable"
            }
        },
        // Serves the documentation book, see book.toml, at http://localhost:3000 and opens it in the browser. It is
        // rebuilt and the browser reloaded whenever a file in docs or book changes. Stop it to stop the server. Needs
        // mdBook, install it with: cargo binstall mdbook
        {
            "type": "node-terminal",
            "request": "launch",
            "name": "Serve Documentation Book",
            "command": "mdbook serve --open",
            "cwd": "${workspaceFolder}"
        },
        // Builds the capture device's firmware, see capture/README.md, flashes it to the CYD plugged in by USB, showing
        // its progress, then shows the device's log. Ctrl+R restarts the device, Ctrl+C stops showing the log, the
        // device runs on. 460800 baud is 4 times faster than espflash's default (921600 fails on the CYD), take --baud out if flashing fails.
        {
            "type": "node-terminal",
            "request": "launch",
            "name": "Flash Capture Device",
            "command": "cargo build --release && espflash flash --baud 460800 --monitor target/xtensa-esp32-espidf/release/marco-sparko-capture",
            "cwd": "${workspaceFolder}/capture"
        },
        // Shows the log of the ESP32 plugged in by USB, without restarting it, see capture/log.py. Ctrl+C stops it, the
        // device runs on. Not espflash monitor, which stops the device even with --no-reset. Stop it before flashing.
        {
            "type": "node-terminal",
            "request": "launch",
            "name": "Capture Device Log",
            "command": "python3 log.py",
            "cwd": "${workspaceFolder}/capture"
        }
