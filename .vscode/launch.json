        // The last build, without building it again.
        {
            "name": "App: Already Built, No Rebuild",
            "presentation": { "group": "1 App", "order": 3 },
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/target/debug/marco-sparko",
            "cwd": "${workspaceFolder}",
            "env": {
                "CARGO_MANIFEST_DIR": "${workspaceFolder}",
                "RUST_BACKTRACE": "1",
                "OS_ACTIVITY_MODE": "disable"
            }
        },

        {
            "type": "lldb",
            "request": "launch",
            "name": "App",
            "presentation": { "group": "1 App", "order": 1 },
            "cargo": {
                "args": [
                    "build",
                    "--bin=marco-sparko",
                    "--package=marco-sparko",
                    "--features=dioxus/desktop"
                ],
                "filter": {
                    "name": "marco-sparko",
                    "kind": "bin"
                }
            },
            "args": [
                "-v"
            ],
            "cwd": "${workspaceFolder}",
            "stdio": [null, "${workspaceFolder}/target/verbose.log", null],
            "env": {
                "CARGO_MANIFEST_DIR": "${workspaceFolder}",
                "RUST_BACKTRACE": "1",
                "OS_ACTIVITY_MODE": "disable"
            }
        },
        // The app with the demo profile, a redacted, offline, copy of a real profile's data, e.g. for screenshots, see
        // docs/Redaction.md. Make or refresh it with: marco-sparko --redact <profile> demo
        {
            "type": "lldb",
            "request": "launch",
            "name": "App: Demo Profile",
            "presentation": { "group": "1 App", "order": 2 },
            "cargo": {
                "args": [
                    "build",
                    "--bin=marco-sparko",
                    "--package=marco-sparko",
                    "--features=dioxus/desktop"
                ],
                "filter": {
                    "name": "marco-sparko",
                    "kind": "bin"
                }
            },
            "args": [
                "-v",
                "--profile",
                "demo"
            ],
            "cwd": "${workspaceFolder}",
            "stdio": [null, "${workspaceFolder}/target/verbose.log", null],
            "env": {
                "CARGO_MANIFEST_DIR": "${workspaceFolder}",
                "RUST_BACKTRACE": "1",
                "OS_ACTIVITY_MODE": "disable"
            }
        },
        // Fetches the latest data without a window, as a scheduled fetch does, see docs/ScheduledFetch.md. It uses the
        // profile the app last used, add "--profile", "<name>" to the args for another one. Its output is in the
        // terminal.
        {
            "type": "lldb",
            "request": "launch",
            "name": "Fetch Latest Data",
            "presentation": { "group": "2 Tools", "order": 1 },
            "cargo": {
                "args": [
                    "build",
                    "--bin=marco-sparko",
                    "--package=marco-sparko",
                    "--features=dioxus/desktop"
                ],
                "filter": {
                    "name": "marco-sparko",
                    "kind": "bin"
                }
            },
            "args": [
                "--fetch"
            ],
            "cwd": "${workspaceFolder}",
            "terminal": "integrated",
            "env": {
                "CARGO_MANIFEST_DIR": "${workspaceFolder}",
                "RUST_BACKTRACE": "1",
                "OS_ACTIVITY_MODE": "disable"
            }
        },
        // Copies a profile's data to the demo profile with everything which identifies you replaced, without a window,
        // see docs/Redaction.md. It asks which profile to copy. Its output is in the terminal.
        {
            "type": "lldb",
            "request": "launch",
            "name": "Redact Profile into Demo",
            "presentation": { "group": "2 Tools", "order": 2 },
            "cargo": {
                "args": [
                    "build",
                    "--bin=marco-sparko",
                    "--package=marco-sparko",
                    "--features=dioxus/desktop"
                ],
                "filter": {
                    "name": "marco-sparko",
                    "kind": "bin"
                }
            },
            "args": [
                "--redact",
                "${input:redactProfile}",
                "demo"
            ],
            "cwd": "${workspaceFolder}",
            "terminal": "integrated",
            "env": {
                "CARGO_MANIFEST_DIR": "${workspaceFolder}",
                "RUST_BACKTRACE": "1",
                "OS_ACTIVITY_MODE": "disable"
            }
        },
        // Takes the screenshots in docs/screenshots.json, then exits, see docs/Screenshots.md: in the data directory
        // /Users/yourname, which it clears first, for the first run, then with a copy of the demo profile. The first
        // time, macOS asks for the Screen Recording permission for VS Code.
        {
            "type": "lldb",
            "request": "launch",
            "name": "Take Screenshots",
            "presentation": { "group": "2 Tools", "order": 4 },
            "cargo": {
                "args": [
                    "build",
                    "--bin=marco-sparko",
                    "--package=marco-sparko",
                    "--features=dioxus/desktop"
                ],
                "filter": {
                    "name": "marco-sparko",
                    "kind": "bin"
                }
            },
            "args": [
                "--home",
                "/Users/yourname",
                "--screenshots"
            ],
            "cwd": "${workspaceFolder}",
            "terminal": "integrated",
            "env": {
                "CARGO_MANIFEST_DIR": "${workspaceFolder}",
                "RUST_BACKTRACE": "1",
                "OS_ACTIVITY_MODE": "disable"
            }
        },
        // Redacts the documents in unredacted_docs into docs, replacing those there, see docs/Redaction.md. Its output
        // is in the terminal.
        {
            "type": "lldb",
            "request": "launch",
            "name": "Redact Docs",
            "presentation": { "group": "2 Tools", "order": 3 },
            "cargo": {
                "args": [
                    "build",
                    "--bin=marco-sparko",
                    "--package=marco-sparko",
                    "--features=dioxus/desktop"
                ],
                "filter": {
                    "name": "marco-sparko",
                    "kind": "bin"
                }
            },
            "args": [
                "--redact",
                "docs"
            ],
            "cwd": "${workspaceFolder}",
            "terminal": "integrated",
            "env": {
                "CARGO_MANIFEST_DIR": "${workspaceFolder}",
                "RUST_BACKTRACE": "1",
                "OS_ACTIVITY_MODE": "disable"
            }
        }
